HOST=127.0.0.1
PORT=4340
THINKEDU_DEMO=true
ALLOWED_ORIGIN=http://localhost:4341,http://127.0.0.1:4342
# Opcional: sem URL, o app usa uma demonstração local persistida no dispositivo.
EXPO_PUBLIC_API_URL=
# Administrativo web: API opcional; sem URL, os dados ficam neste navegador.
VITE_API_URL=
# Controle de releases: arquivo JSON por plataforma, relido a cada consulta.
THINKEDU_RELEASE_FILE=
# Opcional: endpoint HTTPS público /app/version; vazio desativa a consulta.
EXPO_PUBLIC_VERSION_URL=

# Samuca: consultas locais funcionam sem provedor. Ative IA apenas no servidor.
# Configurar esses campos autoriza enviar a pergunta e os fatos consultados à OpenAI.
THINKEDU_AI_ENABLED=false
THINKEDU_AI_MODEL=
OPENAI_API_KEY=
# Login real: arquivo de contas com hashes; nunca incluir credenciais no Git.
THINKEDU_AUTH_FILE=
