{
  "expo": {
    "name": "thinkEdu",
    "slug": "thinkedu",
    "version": "0.2.0",
    "scheme": "thinkedu",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thinksystems.thinkedu",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.thinksystems.thinkedu",
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "name": "thinkEdu · ThinkSystems",
      "favicon": "./assets/thinkedu-icon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-video",
      "expo-notifications",
      "./plugins/withLocalNotifications.cjs",
      "expo-secure-store"
    ],
    "icon": "./assets/thinkedu-icon.png"
  }
}
