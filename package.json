{
  "name": "thinkedu",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/admin",
    "apps/site"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace @thinkedu/mobile",
    "ios:simulator": "npm run ios --workspace @thinkedu/mobile -- --configuration Release --no-bundler",
    "dev:web": "npm run web --workspace @thinkedu/mobile",
    "dev:admin": "npm run dev --workspace @thinkedu/admin",
    "dev:api": "node --env-file-if-exists=.env apps/api/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "npm run typecheck --workspace @thinkedu/mobile && npm run typecheck --workspace @thinkedu/admin",
    "build": "npm run build --workspace @thinkedu/admin && npm run export:web --workspace @thinkedu/mobile && npm run build:site",
    "demo:populate": "node scripts/populate-demo.mjs",
    "dev:site": "npm run dev --workspace @thinkedu/site",
    "build:site": "npm run build --workspace @thinkedu/site"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  }
}
